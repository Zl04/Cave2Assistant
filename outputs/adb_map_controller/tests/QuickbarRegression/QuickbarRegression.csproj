<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0-windows</TargetFramework>
    <IsTestProject>true</IsTestProject>
    <IsPackable>false</IsPackable>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>AdbMapController.Tests</AssemblyName>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\AdbMapController.csproj" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
    <Compile Include="..\QuickbarBackgroundTests.cs" Link="QuickbarBackgroundTests.cs" />
    <None Include="..\VisualFixtures\quickbar-*.png" Link="Fixtures\Visual\%(Filename)%(Extension)" CopyToOutputDirectory="Always" />
    <None Include="..\..\..\..\game-screen\2026-10-20_17-12-28-655.png" Link="Fixtures\Visual\quickbar-mining-runtime.png" CopyToOutputDirectory="Always" />
    <None Include="..\..\Resources\Vision\quickbar-background.png" Link="vision\quickbar-background.png" CopyToOutputDirectory="Always" />
  </ItemGroup>
  <Target Name="CopyNativeOcrRuntime" AfterTargets="Build">
    <PropertyGroup>
      <_OcrSource>$(MSBuildProjectDirectory)\..\..\publish\PaddleOCR</_OcrSource>
      <_OcrDestination>$(TargetDir)PaddleOCR</_OcrDestination>
    </PropertyGroup>
    <MakeDir Directories="$(_OcrDestination)" />
    <Copy SourceFiles="$(_OcrSource)\PaddleOCRSDK.dll"
          DestinationFolder="$(_OcrDestination)" SkipUnchangedFiles="true" />
    <ItemGroup>
      <_OcrNative Include="$(_OcrSource)\native\**\*" />
    </ItemGroup>
    <Copy SourceFiles="@(_OcrNative)"
          DestinationFiles="@(_OcrNative->'$(_OcrDestination)\native\%(RecursiveDir)%(Filename)%(Extension)')"
          SkipUnchangedFiles="true" />
  </Target>
</Project>
