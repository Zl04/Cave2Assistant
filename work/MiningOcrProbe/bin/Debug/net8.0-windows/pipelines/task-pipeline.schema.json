{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "洞窟地图控制器任务 Pipeline",
  "type": "object",
  "required": ["version", "name", "entry", "nodes"],
  "properties": {
    "version": { "const": 1 },
    "name": { "type": "string", "minLength": 1 },
    "entry": { "type": "string", "minLength": 1 },
    "maxTransitions": { "type": "integer", "minimum": 1, "maximum": 1000000, "default": 10000 },
    "nodes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["name", "handler"],
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "handler": { "type": "string", "minLength": 1 },
          "next": { "type": "array", "items": { "type": "string" }, "default": [] },
          "onError": { "type": "array", "items": { "type": "string" }, "default": [] },
          "exceededNext": { "type": "array", "items": { "type": "string" }, "default": [] },
          "enabled": { "type": "boolean", "default": true },
          "maxAttempts": { "type": "integer", "minimum": 1, "maximum": 100, "default": 1 },
          "maxTimes": { "type": "integer", "minimum": -1, "default": -1 },
          "timeoutMs": { "type": "integer", "minimum": -1, "default": -1 },
          "preDelayMs": { "type": "integer", "minimum": 0, "maximum": 300000, "default": 0 },
          "postDelayMs": { "type": "integer", "minimum": 0, "maximum": 300000, "default": 0 }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
