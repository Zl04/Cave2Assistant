<Project>
  <PropertyGroup>
    <!-- Build and restore intermediates must stay inside publish/.build so
         this project never recreates bin/ or obj/ outside the delivery tree. -->
    <BaseOutputPath>$(MSBuildProjectDirectory)\publish\.build\$(MSBuildProjectName)\bin\</BaseOutputPath>
    <BaseIntermediateOutputPath>$(MSBuildProjectDirectory)\publish\.build\$(MSBuildProjectName)\obj\</BaseIntermediateOutputPath>
    <MSBuildProjectExtensionsPath>$(BaseIntermediateOutputPath)</MSBuildProjectExtensionsPath>
    <DefaultItemExcludes>$(DefaultItemExcludes);$(MSBuildProjectDirectory)\publish\**</DefaultItemExcludes>
  </PropertyGroup>


</Project>
