  },
  "CultivateAvailable": {
    "algorithm": "Custom", "handler": "SoulArtifact", "action": "DoNothing",
    "next": ["Cultivate"]
  },
  "Cultivate": {
    "algorithm": "OcrDetect", "handler": "SoulAdb", "action": "ClickSelf",
    "text": ["200000"], "roi": [145, 620, 260, 82],
    "timeout": 3000, "rateLimit": 250, "postDelay": 650,
    "maxTimes": 20, "exceededNext": ["CultivationLimit"],
