{
  "$schema": "https://github.com/MaaAssistantArknights/MaaAssistantArknights/raw/dev-v2/docs/maa_tasks_schema.json",
  "OpenMap": { "algorithm": "Custom", "handler": "AbyssSweep", "action": "DoNothing", "postDelay": 300, "timeout": 6000, "rateLimit": 300, "next": ["MapReady"] },
  "MapReady": { "algorithm": "Custom", "handler": "AbyssSweep", "action": "DoNothing", "next": ["OpenMenu"] },
  "OpenMenu": { "algorithm": "JustReturn", "handler": "AbyssAdb", "action": "ClickRect", "specificRect": [1076, 198, 1, 1], "postDelay": 350, "timeout": 2500, "rateLimit": 250, "next": ["MenuReady"] },
  "MenuReady": { "algorithm": "OcrDetect", "handler": "AbyssAdb", "action": "DoNothing", "text": ["深渊秘境"], "roi": [421, 390, 166, 48], "next": ["OpenAbyss"] },
  "OpenAbyss": { "algorithm": "JustReturn", "handler": "AbyssAdb", "action": "ClickRect", "specificRect": [488, 348, 1, 1], "postDelay": 400, "timeout": 6000, "rateLimit": 300, "next": ["AbyssReady"] },
  "AbyssReady": { "algorithm": "OcrDetect", "handler": "AbyssAdb", "action": "DoNothing", "text": ["深渊模式"], "roi": [637, 57, 268, 61], "next": ["OpenQuantity"] },
  "OpenQuantity": { "algorithm": "JustReturn", "handler": "AbyssAdb", "action": "ClickRect", "specificRect": [757, 334, 1, 1], "postDelay": 350, "timeout": 5000, "rateLimit": 300, "next": ["QuantityReady"] },
  "QuantityReady": { "algorithm": "Custom", "handler": "AbyssSweep", "action": "DoNothing", "next": ["HasKeys", "NoKeys"] },
  "HasKeys": { "algorithm": "Custom", "handler": "AbyssSweep", "action": "DoNothing", "next": ["SetQuantity"] },
  "NoKeys": { "algorithm": "Custom", "handler": "AbyssSweep", "action": "DoNothing", "next": ["CloseQuantity"] },
  "SetQuantity": { "algorithm": "JustReturn", "handler": "AbyssSweep", "action": "DoNothing", "postDelay": 350, "timeout": 3000, "rateLimit": 250, "next": ["QuantitySelected"] },
  "QuantitySelected": { "algorithm": "Custom", "handler": "AbyssSweep", "action": "DoNothing", "next": ["SubmitQuantity"] },
  "SubmitQuantity": { "algorithm": "JustReturn", "handler": "AbyssAdb", "action": "ClickRect", "specificRect": [730, 480, 1, 1], "postDelay": 350, "timeout": 5000, "rateLimit": 300, "next": ["ConfirmationReady"] },
  "ConfirmationReady": { "algorithm": "Custom", "handler": "AbyssSweep", "action": "DoNothing", "next": ["ConfirmSweep"] },
  "ConfirmSweep": { "algorithm": "JustReturn", "handler": "AbyssAdb", "action": "ClickRect", "specificRect": [756, 461, 1, 1], "postDelay": 450, "timeout": 8000, "rateLimit": 350, "next": ["RewardReady"] },
  "RewardReady": { "algorithm": "OcrDetect", "handler": "AbyssAdb", "action": "DoNothing", "text": ["战利品"], "roi": [472, 102, 338, 96], "timeout": 5000, "rateLimit": 300, "next": ["CollectReward"] },
  "CollectReward": { "algorithm": "OcrDetect", "handler": "AbyssAdb", "action": "ClickSelf", "text": ["确定"], "roi": [500, 610, 280, 75], "postDelay": 500, "timeout": 1800, "rateLimit": 250, "maxTimes": 3, "exceededNext": ["RewardCloseFailed"], "onErrorNext": ["CollectReward"], "next": ["RewardClosed"] },
  "RewardClosed": { "algorithm": "Custom", "handler": "AbyssSweep", "action": "DoNothing" },
  "RewardCloseFailed": { "algorithm": "JustReturn", "handler": "AbyssSweep", "action": "DoNothing" },
  "CloseQuantity": { "algorithm": "JustReturn", "handler": "AbyssAdb", "action": "ClickRect", "specificRect": [551, 480, 1, 1], "postDelay": 200, "next": ["CloseAbyss"] },
  "CloseAbyss": { "algorithm": "JustReturn", "handler": "AbyssAdb", "action": "ClickRect", "specificRect": [1179, 153, 1, 1], "postDelay": 200, "next": ["CloseMap"] },
  "CloseMap": { "algorithm": "JustReturn", "handler": "AbyssAdb", "action": "ClickRect", "specificRect": [1147, 89, 1, 1] }
}
