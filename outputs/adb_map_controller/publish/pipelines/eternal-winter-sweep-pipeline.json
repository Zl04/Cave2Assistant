{
  "$schema": "https://github.com/MaaAssistantArknights/MaaAssistantArknights/raw/dev-v2/docs/maa_tasks_schema.json",
  "OpenMap": { "algorithm": "Custom", "handler": "EternalWinterSweep", "action": "DoNothing", "postDelay": 450, "timeout": 6000, "rateLimit": 300, "next": ["MapReady"] },
  "MapReady": { "algorithm": "Custom", "handler": "EternalWinterSweep", "action": "DoNothing", "timeout": 3500, "rateLimit": 300, "next": ["OpenRiftMarker"] },
  "OpenRiftMarker": { "algorithm": "JustReturn", "handler": "EternalWinterAdb", "action": "ClickRect", "specificRect": [857, 549, 1, 1], "postDelay": 350, "next": ["RiftMenuReady"] },
  "RiftMenuReady": { "algorithm": "OcrDetect", "handler": "EternalWinterAdb", "action": "DoNothing", "text": ["永冬裂缝"], "roi": [360, 280, 300, 190], "timeout": 4000, "rateLimit": 250, "next": ["OpenRift"] },
  "OpenRift": { "algorithm": "JustReturn", "handler": "EternalWinterAdb", "action": "ClickRect", "specificRect": [490, 348, 1, 1], "postDelay": 500, "next": ["RiftReady"] },
  "RiftReady": { "algorithm": "Custom", "handler": "EternalWinterSweep", "action": "DoNothing", "timeout": 5000, "rateLimit": 300, "next": ["TargetFloorSelected", "NeedSwitchFloor"] },
  "TargetFloorSelected": { "algorithm": "Custom", "handler": "EternalWinterSweep", "action": "DoNothing", "next": ["SweepGate"] },
  "NeedSwitchFloor": { "algorithm": "Custom", "handler": "EternalWinterSweep", "action": "DoNothing", "next": ["OpenFloorSelection"] },
  "OpenFloorSelection": { "algorithm": "JustReturn", "handler": "EternalWinterAdb", "action": "ClickRect", "specificRect": [316, 354, 1, 1], "postDelay": 350, "next": ["FloorSelectionReady"] },
  "FloorSelectionReady": { "algorithm": "OcrDetect", "handler": "EternalWinterAdb", "action": "DoNothing", "text": ["难度选择"], "roi": [380, 110, 520, 500], "timeout": 4000, "rateLimit": 250, "next": ["LocateTargetFloor", "ScrollFloorList"] },
  "LocateTargetFloor": { "algorithm": "Custom", "handler": "EternalWinterSweep", "action": "DoNothing", "timeout": 800, "rateLimit": 200, "next": ["SelectTargetFloor"] },
  "ScrollFloorList": { "algorithm": "JustReturn", "handler": "EternalWinterSweep", "action": "DoNothing", "postDelay": 300, "maxTimes": 11, "exceededNext": ["DismissLockedFloor"], "next": ["LocateTargetFloor", "ScrollFloorList"] },
  "SelectTargetFloor": { "algorithm": "JustReturn", "handler": "EternalWinterSweep", "action": "DoNothing", "postDelay": 400, "next": ["FloorChanged", "FloorLocked"] },
  "FloorChanged": { "algorithm": "Custom", "handler": "EternalWinterSweep", "action": "DoNothing", "timeout": 1500, "rateLimit": 250, "next": ["SweepGate"] },
  "FloorLocked": { "algorithm": "Custom", "handler": "EternalWinterSweep", "action": "DoNothing", "timeout": 1500, "rateLimit": 250, "next": ["DismissLockedFloor"] },
  "DismissLockedFloor": { "algorithm": "JustReturn", "handler": "EternalWinterAdb", "action": "ClickRect", "specificRect": [969, 637, 1, 1], "postDelay": 250, "next": ["CloseRift"] },
  "SweepGate": { "algorithm": "JustReturn", "handler": "EternalWinterSweep", "action": "DoNothing", "next": ["SweepComplete", "SweepAvailable", "SweepUnavailable"] },
  "SweepComplete": { "algorithm": "Custom", "handler": "EternalWinterSweep", "action": "DoNothing", "next": ["CloseRift"] },
  "SweepAvailable": { "algorithm": "Custom", "handler": "EternalWinterSweep", "action": "DoNothing", "timeout": 1500, "rateLimit": 250, "next": ["ClickSweep"] },
  "SweepUnavailable": { "algorithm": "Custom", "handler": "EternalWinterSweep", "action": "DoNothing", "timeout": 1500, "rateLimit": 250, "next": ["CloseRift"] },
  "ClickSweep": { "algorithm": "JustReturn", "handler": "EternalWinterAdb", "action": "ClickRect", "specificRect": [316, 580, 1, 1], "postDelay": 400, "next": ["RewardReady"] },
  "RewardReady": { "algorithm": "OcrDetect", "handler": "EternalWinterAdb", "action": "DoNothing", "text": ["宝物获得"], "roi": [300, 100, 680, 470], "timeout": 4000, "rateLimit": 250, "next": ["ConfirmReward"] },
  "ConfirmReward": { "algorithm": "JustReturn", "handler": "EternalWinterAdb", "action": "ClickRect", "specificRect": [640, 516, 1, 1], "postDelay": 350, "next": ["SweepRecorded"] },
  "SweepRecorded": { "algorithm": "Custom", "handler": "EternalWinterSweep", "action": "DoNothing", "next": ["SweepGate"] },
  "CloseRift": { "algorithm": "JustReturn", "handler": "EternalWinterAdb", "action": "ClickRect", "specificRect": [1177, 157, 1, 1], "postDelay": 600, "next": ["CloseMap"] },
  "CloseMap": { "algorithm": "JustReturn", "handler": "EternalWinterAdb", "action": "ClickRect", "specificRect": [1147, 89, 1, 1], "postDelay": 500, "maxTimes": 5, "next": ["MapClosed", "CloseMap"] },
  "MapClosed": { "algorithm": "Custom", "handler": "EternalWinterSweep", "action": "DoNothing", "timeout": 1000, "rateLimit": 250 }
}
