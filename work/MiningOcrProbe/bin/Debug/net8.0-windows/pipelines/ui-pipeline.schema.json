{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "洞窟地图控制器 UI Pipeline",
  "type": "object",
  "required": ["version", "name", "nodes"],
  "properties": {
    "version": { "const": 1 },
    "name": { "type": "string", "minLength": 1 },
    "nodes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["name", "result", "recognizer"],
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "result": { "type": "string", "minLength": 1 },
          "recognizer": { "type": "string", "minLength": 1 },
          "priority": { "type": "integer" },
          "enabled": { "type": "boolean", "default": true },
          "maxAttempts": { "type": "integer", "minimum": 1, "maximum": 10, "default": 1 },
          "timeoutMs": { "type": "integer", "minimum": -1, "default": 2500 }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
