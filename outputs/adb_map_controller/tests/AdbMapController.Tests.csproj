<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0-windows</TargetFramework>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="FakeAdb\FakeAdb.csproj" ReferenceOutputAssembly="false" />
    <Compile Remove="FakeAdb\**\*.cs" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="4.11.0" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>
  <ItemGroup>
    <Compile Remove="baseline\**\*.cs" />
    <Compile Include="baseline\StateAndJsonBaselineTests.cs;baseline\RouteSafetyBaselineTests.cs;baseline\PipelineBaselineTests.cs;baseline\PortalLearningBaselineTests.cs;baseline\SettingsFailureBaselineTests.cs" />
    <ProjectReference Include="..\AdbMapController.csproj" />
    <None Update="baseline\Fixtures\*.json" TargetPath="Fixtures\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\Resources\Automation\*.json" Link="Fixtures\Production\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\Resources\Assistant\MiniMapDrawer.template.lua" Link="Fixtures\Assistant\MiniMapDrawer.template.lua" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\Domain\**\*.cs" Link="Fixtures\Architecture\Domain\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\Navigation\**\*.cs" Link="Fixtures\Architecture\Navigation\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\Application\**\*.cs" Exclude="..\Application\ControllerRuntime.cs" Link="Fixtures\Architecture\Application\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <None Update="VisualFixtures\**\*.png" Link="Fixtures\Visual\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <Target Name="CopyFakeAdbFixture" AfterTargets="Build">
    <PropertyGroup>
      <_FakeAdbSource>$(MSBuildProjectDirectory)\FakeAdb\publish\.build\FakeAdb\bin\$(Configuration)\net8.0</_FakeAdbSource>
      <_FakeAdbDestination>$(TargetDir)</_FakeAdbDestination>
    </PropertyGroup>
    <MakeDir Directories="$(_FakeAdbDestination)" />
    <Copy SourceFiles="$(_FakeAdbSource)\adb.exe;$(_FakeAdbSource)\adb.dll;$(_FakeAdbSource)\adb.deps.json;$(_FakeAdbSource)\adb.runtimeconfig.json"
          DestinationFolder="$(_FakeAdbDestination)" SkipUnchangedFiles="true" />
  </Target>
</Project>
