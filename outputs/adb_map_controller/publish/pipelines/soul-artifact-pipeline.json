{
  "SoulReady": {
    "algorithm": "Custom", "handler": "SoulArtifact", "action": "DoNothing",
    "next": ["Exhausted", "CultivateAvailable"], "timeout": 5000, "rateLimit": 250
  },
  "SelectSoulTab": {
    "algorithm": "OcrDetect", "handler": "SoulAdb", "action": "ClickSelf",
